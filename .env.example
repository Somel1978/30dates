# --- Database ---------------------------------------------------------------
# Application role: non-superuser so row-level security on escrow tables is enforced.
DATABASE_URL=postgres://thirtydates_app:thirtydates_app@localhost:5432/thirtydates
# Superuser URL, only used by the test harness to recreate the test database.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Secrets (generate with: openssl rand -hex 32) ---------------------------
JWT_SECRET=change-me-to-64-hex-chars
ESCROW_PAIR_SALT=change-me-to-64-hex-chars
CRON_SECRET=change-me

# --- HTTP --------------------------------------------------------------------
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Next.js proxies /api/* to this origin.
API_ORIGIN=http://localhost:4000

# --- Email (magic links). Leave SMTP_URL empty in development to log links. ---
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Thirty Dates <hello@thirtydates.local>"

# --- Storage -------------------------------------------------------------------
UPLOAD_DIR=./uploads
