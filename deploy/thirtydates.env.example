# ~/30dates/.env — read by the API and worker services (keep it chmod 600).
# Generate each secret with:  openssl rand -hex 32

# "development" = testing on your LAN: sign-in links are printed in the API log, no email needed.
# "production"  = real use: requires SMTP_URL; use an https:// address in WEB_ORIGIN.
NODE_ENV=development

DATABASE_URL=postgres://thirtydates_app:CHANGE_ME_DB_PASSWORD@localhost:5432/thirtydates

JWT_SECRET=CHANGE_ME
ESCROW_PAIR_SALT=CHANGE_ME
CRON_SECRET=CHANGE_ME

# Every address you open the site with, comma-separated (scheme + host + port).
# Sign-in links go back to whichever address you used; any other address is rejected.
# e.g. http://192.168.1.50:3000,http://30plus:3000,https://dates.example.com
WEB_ORIGIN=http://CONTAINER_IP:3000

API_HOST=127.0.0.1
API_PORT=4000
# Outside the git checkout so updates never touch member photos.
UPLOAD_DIR=__APP_HOME__/30dates-data/uploads

# Leave empty for LAN testing. For production, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Thirty Dates <hello@example.com>"
