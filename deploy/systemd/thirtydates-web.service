[Unit]
Description=Thirty Dates web app
After=network-online.target thirtydates-api.service
Wants=network-online.target

[Service]
Type=simple
User=thirtydates
Group=thirtydates
WorkingDirectory=/opt/thirtydates/app/apps/web
Environment=NODE_ENV=production
# 0.0.0.0 = reachable from your LAN on port 3000.
# Set to 127.0.0.1 when Caddy (HTTPS) sits in front of it.
Environment=WEB_HOST=0.0.0.0
ExecStart=/usr/bin/node /opt/thirtydates/app/node_modules/next/dist/bin/next start -p 3000 -H ${WEB_HOST}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
